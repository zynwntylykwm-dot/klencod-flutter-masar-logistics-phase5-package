            // دوال التتبع
            window.portalOpenTracking = function() {
                document.querySelectorAll('.global-portal-page .page').forEach(p => p.style.display = 'none');
                document.querySelectorAll('.global-portal-page .page').forEach(p => p.classList.remove('active'));
                document.getElementById('portalTrackingPage').classList.add('active');
                document.getElementById('portalTrackingPage').style.display = 'block';
                updatePortalShipmentsList();
            };

            window.portalSearchTracking = function() {
                const query = document.getElementById('portalTrackingSearch').value.trim().toUpperCase();
                if (!query) {
                    updatePortalShipmentsList();
                    return;
                }
                
                const shipments = portalState.getShipments();
                const filtered = shipments.filter(s => 
                    s.trackingNumber.includes(query) || 

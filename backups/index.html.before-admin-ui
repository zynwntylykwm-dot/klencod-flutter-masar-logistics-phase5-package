        function walletUndoLastTransaction() {
            if (!walletLastTransaction) { alert('لا توجد عملية للتراجع عنها'); return; }
            const { type, cardId, amount, targetCardId } = walletLastTransaction;
            const card = getWalletCardById(cardId);
            if (!card) { alert('البطاقة غير موجودة'); return; }
            let targetCard = null;
            if (targetCardId) { targetCard = getWalletCardById(targetCardId); }
            if (type === 'إيداع' || type === 'تحويل') {

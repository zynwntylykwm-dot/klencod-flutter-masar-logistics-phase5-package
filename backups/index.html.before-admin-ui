        .welcome-btn { background: linear-gradient(135deg, var(--accent-red), #ff4455); border: none; padding: 12px 24px; border-radius: 30px; color: white; font-weight: 700; cursor: pointer; }
        .settings-section { margin-bottom: 25px; border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow: hidden; }

                size: document.getElementById('newSize').value || '',
                invoiceValue: parseFloat(document.getElementById('newInvoiceValue').value) || 0,
                shippingCost: parseFloat(document.getElementById('newShippingCost').value) || 0,
                customsFees: parseFloat(document.getElementById('newCustomsFees').value) || 0,
                paid: parseFloat(document.getElementById('newPaid').value) || 0,
                remaining: parseFloat(document.getElementById('newRemaining').value) || 0,
                penalties: parseFloat(document.getElementById('newPenalties').value) || 0,
                currentLocation: document.getElementById('newCurrentLocation').value || '',
                lat: parseFloat(document.getElementById('newLat').value) || 0,
                lng: parseFloat(document.getElementById('newLng').value) || 0,
                mapLink: document.getElementById('newMapLink').value || '',
                history: [],
                adminNotes: document.getElementById('adminNotes').value || ''
            };
            for(let i = 1; i <= 5; i++) {
                let location = document.getElementById(`stopLocation${i}`)?.value;
                let date = document.getElementById(`stopDate${i}`)?.value;
                let time = document.getElementById(`stopTime${i}`)?.value;
                let status = document.getElementById(`stopStatus${i}`)?.value;
                if(location || date || time || status) {
                    newShipment.history.push({ location: location || 'غير محدد', date: date || new Date().toISOString().split('T')[0], time: time || '00:00', status: status || 'غير محدد' });
                }
            }
            shipments.push(newShipment);
            localStorage.setItem('alshahd_shipments', JSON.stringify(shipments));
            showToast(`✅ تم حفظ الشحنة ${newShipment.trackingNumber} بنجاح`);
            refreshAllPages();
            navigateTo('myShipmentsPage');
        }


        .app-header { display: flex; justify-content: space-between; align-items: center; margin: 15px 0 20px; position: relative; }
        .user-profile { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .avatar-circle { width: 42px; height: 42px; background: var(--primary-blue); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 18px; position: relative; overflow: hidden; }
        .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
        .promo-banner { background: linear-gradient(135deg, var(--primary-blue), var(--secondary-blue)); border-radius: var(--border-radius); padding: 16px; display: flex; align-items: center; justify-content: space-between; color: #fff; transition: all 0.5s ease; min-height: 70px; }
        .page-title { font-size: 20px; font-weight: 800; color: var(--primary-blue); margin-bottom: 15px; display: flex; align-items: center; gap: 10px; }
        .map-container { margin-top: 15px; border-radius: 20px; overflow: hidden; display: none; }
        #shipmentMap { height: 320px; width: 100%; border-radius: 20px; }
        .share-location-btn { background: #16a34a; color: white; border: none; padding: 10px; border-radius: 25px; cursor: pointer; margin-top: 10px; font-size: 13px; width: 100%; }
        .calculator-card, .wallet-card { background: #fff; border-radius: 22px; padding: 16px; margin-bottom: 15px; border: 1px solid var(--border-color); box-shadow: var(--shadow-light); }
        .result-box { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 16px; padding: 16px; margin-top: 15px; text-align: center; }
        .wallet-balance { font-size: 32px; font-weight: 800; color: #10b981; }
        .transaction-item { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 5px; }
        .transaction-item:last-child { border-bottom: none; }
        .card-number { font-size: 18px; letter-spacing: 2px; margin: 15px 0; font-weight: 700; }
        .ai-chat { position: fixed; bottom: 100px; right: 20px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-red), #ff4455); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
        .chat-window { position: fixed; bottom: 170px; right: 20px; width: 340px; height: 480px; background: #fff; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); display: none; flex-direction: column; z-index: 1001; overflow: hidden; }
        .chat-header { background: linear-gradient(135deg, #005691, #00a6ff); color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
        .chat-messages { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .chat-message { max-width: 85%; padding: 10px 14px; border-radius: 18px; font-size: 13px; }
        .chat-message.user { background: #005691; color: white; align-self: flex-end; }
        .chat-message.bot { background: #eef2f7; color: #101828; align-self: flex-start; }
        .chat-input-area { display: flex; padding: 10px; border-top: 1px solid #edf0f5; gap: 8px; }
        .chat-input-area input { flex: 1; padding: 12px; border: 1px solid #dce2ea; border-radius: 25px; outline: none; }
        .chat-input-area button { width: 45px; background: #005691; color: white; border: none; border-radius: 50%; cursor: pointer; }
        .date-range { display: none; gap: 10px; margin-bottom: 15px; align-items: center; flex-wrap: wrap; }

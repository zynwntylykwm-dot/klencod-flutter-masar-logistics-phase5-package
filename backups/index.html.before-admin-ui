                if (!card) { alert('❌ البطاقة غير موجودة'); return; }
                // إضافة المبلغ بالسالب على البطاقة (دين)
                card.balance = parseFloat((card.balance - amount).toFixed(2));
                // إضافة تنبيه سداد
                const today = new Date();
                const due = new Date(dueDate);
                const diffDays = Math.ceil((due - today) / (1000 * 60 * 60 * 24));
                if (diffDays > 0) {
                    addNotification('⏰', `تنبيه: موعد سداد الدفع الآجل بعد ${diffDays} يوم. المبلغ: ${formatWalletCurrency(amount)}`);

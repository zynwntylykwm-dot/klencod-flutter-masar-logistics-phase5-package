        window.copyToClipboard = function(text) {
            const clean = String(text == null ? '' : text);
            const done = () => { if (typeof showToast === 'function') showToast('📋 تم نسخ: ' + clean); };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(clean).then(done).catch(() => fallbackCopy(clean, done));
            } else { fallbackCopy(clean, done); }
            function fallbackCopy(txt, cb) {
                const ta = document.createElement('textarea');
                ta.value = txt; ta.setAttribute('readonly', '');
                ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); cb(); }
                catch (e) { if (typeof showToast === 'function') showToast('تعذّر النسخ، انسخ يدويًا: ' + txt); }
                document.body.removeChild(ta);
            }
        };


                const commitment = document.getElementById('portalCreditCommitment')?.value;
                if (!cardId) { alert('❌ يرجى اختيار بطاقة'); return; }
                if (!dueDate) { alert('❌ يرجى تحديد تاريخ السداد'); return; }
                if (!commitment) { alert('❌ يرجى تعبئة نموذج التزام السداد'); return; }

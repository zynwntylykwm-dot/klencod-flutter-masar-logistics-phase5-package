                if (findUserByIdentifier(username)) { showToast('اسم المستخدم موجود بالفعل'); return; }
                if (findUserByIdentifier(email)) { showToast('البريد الإلكتروني موجود بالفعل'); return; }
                const newUser = { id: "USR-" + Math.random().toString(36).substr(2, 6).toUpperCase(), fullName: name, email: email, phone: phone || '', username: username, password: password, role: role || 'user', status: status || 'active', createdAt: new Date().toISOString() };

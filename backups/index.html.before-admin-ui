    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Cairo', sans-serif; }
        :root {
            --bg-global: #f0f2f5; --card-bg: #ffffff; --primary-blue: #0a2540;
            --secondary-blue: #1a4a7a; --accent-red: #d40511; --success-green: #10b981;
            --text-dark: #1a2a3a; --text-muted: #6b7280; --border-color: #e5e7eb;

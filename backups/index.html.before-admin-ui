                const query = document.getElementById('portalSearchInput').value.toLowerCase().trim();
                
                appData.categories.forEach(cat => {
                    const grid = document.getElementById(`portal_grid_${cat.id}`);
                    if (!grid) return;
                    
                    const cards = grid.querySelectorAll('.card');
                    let visibleCount = 0;
                    
                    cards.forEach(card => {
                        const name = card.dataset.site.toLowerCase();
                        const categoryLabel = card.querySelector('.category-label')?.textContent || '';
                        const matches = !query || name.includes(query) || categoryLabel.includes(query);
                        card.style.display = matches ? '' : 'none';
                        if (matches) visibleCount++;
                    });
                    
                    const noResults = grid.querySelector('.no-results');
                    if (noResults) {
                        noResults.style.display = (visibleCount === 0 && query !== '') ? 'block' : 'none';

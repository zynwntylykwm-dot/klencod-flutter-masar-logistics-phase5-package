        .login-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #0a2540 0%, #1a4a7a 100%); z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 20px; }

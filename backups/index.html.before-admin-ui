        // ---- Analytics ----
        function renderAnalyticsPage() {
            const grid = document.getElementById('analyticsGrid');
            if (!grid) return;
            const totalShipments = shipments.length;
            const delivered = shipments.filter(s => s.status === 'delivered').length;
            const shipped = shipments.filter(s => s.status === 'shipped').length;
            const totalValue = shipments.reduce((sum, s) => sum + (s.invoiceValue || 0), 0);
            const avgDeliveryTime = shipments.filter(s => s.status === 'delivered' && s.deliveryDate && s.creationDate).reduce((sum, s) => {
                const d1 = new Date(s.creationDate);
                const d2 = new Date(s.deliveryDate);
                return sum + (d2 - d1) / (1000 * 60 * 60 * 24);
            }, 0) / (shipments.filter(s => s.status === 'delivered' && s.deliveryDate && s.creationDate).length || 1);
            grid.innerHTML = `
                <div class="analytics-card"><div class="analytics-number">${totalShipments}</div><div class="analytics-label">إجمالي الشحنات</div></div>
                <div class="analytics-card"><div class="analytics-number">${delivered}</div><div class="analytics-label">تم التسليم</div></div>
                <div class="analytics-card"><div class="analytics-number">${shipped}</div><div class="analytics-label">في الطريق</div></div>
                <div class="analytics-card"><div class="analytics-number">$${totalValue.toLocaleString()}</div><div class="analytics-label">القيمة الإجمالية</div></div>
                <div class="analytics-card"><div class="analytics-number">${avgDeliveryTime.toFixed(1)}</div><div class="analytics-label">متوسط وقت التسليم (يوم)</div></div>
                <div class="analytics-card"><div class="analytics-number">${warehouses.length}</div><div class="analytics-label">المستودعات</div></div>
            `;
            // Monthly chart
            const ctx = document.getElementById('analyticsChart').getContext('2d');
            if (window.analyticsChartInstance) window.analyticsChartInstance.destroy();
            const months = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
            const monthlyData = months.map((m, i) => {
                const monthNum = i + 1;
                return shipments.filter(s => {
                    if (!s.creationDate) return false;
                    const d = new Date(s.creationDate);
                    return d.getMonth() + 1 === monthNum;
                }).length;
            });
            window.analyticsChartInstance = new Chart(ctx, {
                type: 'bar',
                data: { labels: months, datasets: [{ label: 'عدد الشحنات', data: monthlyData, backgroundColor: '#0a2540', borderRadius: 4 }] },
                options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
            });
            // Destinations
            const destMap = {};
            shipments.forEach(s => { const dest = s.destPort || 'غير محدد'; destMap[dest] = (destMap[dest] || 0) + 1; });
            const sortedDest = Object.entries(destMap).sort((a,b) => b[1] - a[1]);
            document.getElementById('analyticsDestinations').innerHTML = sortedDest.map(([d, c]) => `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #e5e7eb;font-size:13px;"><span>${d}</span><span style="font-weight:700;">${c} شحنة</span></div>`).join('');
        }


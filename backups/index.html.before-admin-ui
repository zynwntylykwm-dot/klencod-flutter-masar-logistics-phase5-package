        function saveUserFormData(userId) {
            let name = document.getElementById('userName')?.value;
            let email = document.getElementById('userEmail')?.value;
            let phone = document.getElementById('userPhone')?.value;
            let username = document.getElementById('userUsername')?.value;
            let role = document.getElementById('userRole')?.value;
            let status = document.getElementById('userStatus')?.value;
            let password = document.getElementById('userPassword')?.value;
            if (!name || !email || !username) { showToast('الرجاء ملء الحقول المطلوبة'); return; }
            if (userId) {
                const index = systemUsers.findIndex(u => u.id === userId);
                if (index !== -1) { systemUsers[index].fullName = name; systemUsers[index].email = email; systemUsers[index].phone = phone || ''; systemUsers[index].username = username; systemUsers[index].role = role; systemUsers[index].status = status; if (password && password.length > 0) { systemUsers[index].password = password; } saveSystemUsers(); }

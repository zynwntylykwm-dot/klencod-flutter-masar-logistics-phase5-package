        .stat-card { background: linear-gradient(135deg, var(--primary-blue), var(--secondary-blue)); color: white; border-radius: 18px; padding: 15px; text-align: center; }
        .print-btn { background: #6b7280; }
        .warning-banner { background: #fef3c7; border: 1px solid #f59e0b; color: #92400e; padding: 12px; border-radius: 14px; margin-bottom: 15px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .progress-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 10px; overflow: hidden; margin: 8px 0; }
        .progress-fill { height: 100%; background: #10b981; border-radius: 10px; }
        .bank-select { width: 100%; padding: 12px; border-radius: 14px; border: 1px solid var(--field-border); background: var(--field-bg); }
        .receipt-card { background: #f8fafc; border-radius: 16px; padding: 16px; margin-top: 10px; border: 1px solid #e2e8f0; }
        .action-buttons { display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap; }
        .action-buttons button { flex: 1; min-width: 120px; }
        .blur-balance { filter: blur(5px); }
        .eye-icon { cursor: pointer; font-size: 18px; margin-right: 10px; }
        .limit-warning { background: #fee2e2; border-right: 4px solid #dc2626; padding: 10px; margin-bottom: 15px; border-radius: 12px; font-size: 12px; }
        .welcome-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 2000; opacity: 0; visibility: hidden; transition: all 0.3s ease; }
        .welcome-modal-overlay.show { opacity: 1; visibility: visible; }
        .welcome-card { background: linear-gradient(135deg, #ffffff, #f8fafc); border-radius: 32px; padding: 30px; text-align: center; max-width: 320px; width: 90%; transform: scale(0.8); transition: transform 0.3s ease; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
        .welcome-modal-overlay.show .welcome-card { transform: scale(1); }

                const weight = parseFloat(document.getElementById('portalShippingWeight').value) || 1;
                const shippingRate = 25; // 25 دولار لكل كيلو
                const subtotal = price * quantity;
                const shippingCost = weight * shippingRate;
                const total = subtotal + shippingCost;
                
                document.getElementById('portalSubtotal').textContent = subtotal.toFixed(2);
                document.getElementById('portalShippingCostDisplay').textContent = shippingCost.toFixed(2);
                document.getElementById('portalTotalAmount').textContent = total.toFixed(2);
                document.getElementById('portalTotalAmount2').textContent = total.toFixed(2);

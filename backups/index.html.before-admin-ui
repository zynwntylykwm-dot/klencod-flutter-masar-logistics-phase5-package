        // ==================== دوال صفحة شحناتي ====================
        function displayShipments(filter) {
            let filtered = [];
            if (filter === 'all') filtered = [...shipments];
            else if (filter === 'shipped') filtered = shipments.filter(s => s.status === 'shipped');
            else if (filter === 'processing') filtered = shipments.filter(s => s.status === 'processing');
            else if (filter === 'delivered') filtered = shipments.filter(s => s.status === 'delivered');
            else if (filter === 'pending') filtered = shipments.filter(s => s.status === 'pending');
            filtered.sort((a, b) => { if (a.creationDate > b.creationDate) return -1; if (a.creationDate < b.creationDate) return 1; return 0; });
            let html = `<div class="track-box"><div class="track-number">📊 إجمالي الشحنات: ${filtered.length}</div></div>`;
            if (filtered.length === 0) { html += `<div class="calculator-card" style="text-align:center;padding:30px;">لا توجد شحنات</div>`; document.getElementById('shipmentsList').innerHTML = html; return; }
            filtered.forEach(s => {
                let remainingAmount = s.remaining !== undefined ? s.remaining : (s.shippingCost || 0) - (s.paid || 0);
                let statusText = '', statusColor = '', statusBg = '';
                switch(s.status) {
                    case 'shipped': statusText = 'في الطريق'; statusColor = '#f59e0b'; statusBg = '#fef3c7'; break;
                    case 'delivered': statusText = 'تم التسليم'; statusColor = '#10b981'; statusBg = '#d1fae5'; break;
                    case 'processing': statusText = 'قيد التجهيز'; statusColor = '#3b82f6'; statusBg = '#dbeafe'; break;
                    case 'pending': statusText = 'في انتظار التسليم'; statusColor = '#8b5cf6'; statusBg = '#ede9fe'; break;
                    default: statusText = s.status; statusColor = '#6b7280'; statusBg = '#f3f4f6';
                }
                let progressPercent = s.progress || 0;
                if (s.status === 'delivered') progressPercent = 100;
                let creationDate = s.creationDate ? new Date(s.creationDate).toLocaleDateString('ar-EG') : '';
                html += `
                    <div class="shipment" onclick="showShipmentDetails('${s.trackingNumber}')">
                        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;"><span class="shipment-number">📦 ${s.trackingNumber}</span><span style="background:${statusBg};color:${statusColor};padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;border:1px solid ${statusColor};">${statusText}</span></div>
                        <div style="font-size:12px;margin-top:8px;color:var(--text-muted);">📍 ${s.currentLocation || 'غير محدد'}</div>
                        <div style="font-size:12px;color:var(--text-muted);">👤 المستلم: ${s.receiver || 'غير محدد'}</div>
                        <div style="font-size:12px;color:var(--text-muted);display:flex;justify-content:space-between;flex-wrap:wrap;"><span>💵 المتبقي: $${remainingAmount.toLocaleString()}</span><span>📅 ${creationDate}</span></div>
                        <div class="progress-bar"><div class="progress-fill" style="width:${progressPercent}%;background:${statusColor};"></div></div>
                        <div style="font-size:11px;color:var(--text-muted);text-align:left;">${progressPercent}%</div>
                        <button class="copy-btn" style="margin-top:8px;width:100%;" onclick="event.stopPropagation();copyToClipboard('${s.trackingNumber}')"><i class="fa-regular fa-copy"></i> نسخ الرقم</button>
                    </div>
                `;
            });
            document.getElementById('shipmentsList').innerHTML = html;
        }

        function filterShipments(type, event) {

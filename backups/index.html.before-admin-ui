        .nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #6b7280; font-size: 11px; font-weight: 600; cursor: pointer; user-select: none; -webkit-user-select: none; -moz-user-select: none; }

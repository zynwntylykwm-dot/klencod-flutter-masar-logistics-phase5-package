        function addTrackingPoint() {
            let trackingNumber = document.getElementById('newTrackingNumber').value;
            let shipment = shipments.find(s => s.trackingNumber === trackingNumber);
            if (shipment) {
                let newPoint = { location: prompt("📍 أدخل موقع النقطة الجديدة:"), date: new Date().toISOString().split('T')[0], time: new Date().toTimeString().slice(0,5), status: prompt("📌 أدخل حالة النقطة:") };

        function saveContract() {
            const title = document.getElementById('contractTitle')?.value.trim();
            const supplier = document.getElementById('contractSupplier')?.value.trim();
            const startDate = document.getElementById('contractStart')?.value;
            const endDate = document.getElementById('contractEnd')?.value;
            const status = document.getElementById('contractStatus')?.value;
            const notes = document.getElementById('contractNotes')?.value.trim();
            if (!title || !supplier || !startDate || !endDate) { showToast('الرجاء ملء الحقول المطلوبة'); return; }
            loadContractData();
            const newId = contractData.length > 0 ? Math.max(...contractData.map(c => c.id)) + 1 : 1;
            contractData.push({ id: newId, title, supplier, startDate, endDate, status, notes });
            saveContractData();
            closeModal();
            renderContractsPage();
            showToast('✅ تم إضافة العقد بنجاح');
            addNotification('📄', `تم إضافة عقد جديد: ${title}`);
        }

        function deleteContract(id) {
            if (confirm('هل أنت متأكد من حذف هذا العقد؟')) {
                loadContractData();
                contractData = contractData.filter(c => c.id != id);
                saveContractData();
                renderContractsPage();
                showToast('تم حذف العقد');
            }
        }


            `;
        }

        function getSourceMultiplier(source) { const multipliers = { 'US': 1.2, 'CN': 1.0, 'TR': 0.9, 'UAE': 0.8 }; return multipliers[source] || 1.0; }
        function getDestMultiplier(dest) { const multipliers = { 'YE': 1.3, 'SA': 1.0, 'OM': 0.9 }; return multipliers[dest] || 1.0; }
        function getTypeMultiplier(type) { const multipliers = { 'general': 1.0, 'electronics': 1.1, 'vehicles': 1.5, 'heavy': 2.0 }; return multipliers[type] || 1.0; }
        function getSourceName(source) { const names = { 'US': 'الولايات المتحدة', 'CN': 'الصين', 'TR': 'تركيا', 'UAE': 'الإمارات' }; return names[source] || source; }
        function getDestName(dest) { const names = { 'YE': 'اليمن', 'SA': 'السعودية', 'OM': 'عمان' }; return names[dest] || dest; }
        function getTypeName(type) { const names = { 'general': 'بضائع عامة', 'electronics': 'إلكترونيات', 'vehicles': 'مركبات', 'heavy': 'معدات ثقيلة' }; return names[type] || type; }

        function calculateShipping() {
            const weight = parseFloat(document.getElementById('calcWeight')?.value);
            const source = document.getElementById('calcSource')?.value || 'US';
            const dest = document.getElementById('calcDest')?.value || 'YE';
            const type = document.getElementById('calcType')?.value || 'general';
            if (!weight || weight <= 0) { showToast("⚠️ الرجاء إدخال وزن صحيح"); return; }
            const baseCost = weight * 15;
            const sourceMultiplier = getSourceMultiplier(source);
            const destMultiplier = getDestMultiplier(dest);
            const typeMultiplier = getTypeMultiplier(type);
            const finalCost = baseCost * sourceMultiplier * destMultiplier * typeMultiplier;
            const customsFees = finalCost * 0.1;
            const total = finalCost + customsFees;
            const resultDiv = document.getElementById('calcResult');
            resultDiv.style.display = 'block';
            resultDiv.innerHTML = `
                <h3 style="color:var(--primary-blue);margin-bottom:10px;">💰 التكلفة التقديرية</h3>
                <p style="margin:5px 0;font-size:14px;">التكلفة الأساسية: <strong>$${finalCost.toLocaleString()}</strong></p>
                <p style="margin:5px 0;font-size:14px;">الرسوم الجمركية (تقديرية 10%): <strong>$${customsFees.toLocaleString()}</strong></p>
                <p style="margin:10px 0;font-size:20px;font-weight:800;color:#10b981;">الإجمالي: $${total.toLocaleString()}</p>
                <div style="margin-top:10px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;padding-top:10px;">
                    🏷️ بلد التصدير: ${getSourceName(source)} | بلد الوصول: ${getDestName(dest)}
                    <br>📦 نوع الشحنة: ${getTypeName(type)} | ⚖️ الوزن: ${weight} كجم
                    <br>📊 عوامل التعديل: تصدير (${sourceMultiplier}x) | وصول (${destMultiplier}x) | نوع (${typeMultiplier}x)
                </div>
                <div style="margin-top:8px;font-size:11px;color:#6b7280;">💡 السعر التقديري لكل كجم: $${(total / weight).toFixed(2)}</div>
            `;
        }


    <script>
        // ==================== نظام المستخدمين المتقدم مع الصلاحيات ====================
        let systemUsers = [];
        let pendingUsers = [];
        const validStaffNumbers = ['58317','74192','36854','92571','41786','68243','53928','87415','29637','75184','43862','91735','62489','38571','86294','54736','19385','72841','46593','81427','35768','94153','68275','52418','87362','41975','75623','23894','69517','84236'];
        
        const defaultUsers = [
            { id: "USR-001", fullName: "طلال قائد احمد المخلافي", email: "talal@alshahd.com", phone: "713006222", username: "talalalmklafe", password: "12580Radman@1", role: "super_admin", status: "active", createdAt: new Date().toISOString() },
            { id: "USR-002", fullName: "طه ثابت محمد الموشكي", email: "taha@alshahd.com", phone: "777772061", username: "taha123", password: "12580taha", role: "user", status: "active", createdAt: new Date().toISOString() }
        ];

        let currentLoggedInUser = null;
        let tempResetData = null;

        function loadSystemUsers() {
            const stored = localStorage.getItem("alshahd_system_users");
            if (stored) {
                systemUsers = JSON.parse(stored);
            } else {
                systemUsers = [...defaultUsers];
                localStorage.setItem("alshahd_system_users", JSON.stringify(systemUsers));
            }
            const pending = localStorage.getItem("alshahd_pending_users");
            if (pending) {
                pendingUsers = JSON.parse(pending);
            } else {
                pendingUsers = [];
                localStorage.setItem("alshahd_pending_users", JSON.stringify(pendingUsers));
            }
        }

        function saveSystemUsers() {
            localStorage.setItem("alshahd_system_users", JSON.stringify(systemUsers));
            localStorage.setItem("alshahd_pending_users", JSON.stringify(pendingUsers));
            if (window.systemSettings) {
                window.systemSettings.users = systemUsers.map(u => ({
                    id: u.id, name: u.fullName, email: u.email, phone: u.phone, role: u.role, status: u.status
                }));
                localStorage.setItem('alshahd_system_settings', JSON.stringify(window.systemSettings));
            }
        }

        function findUserByIdentifier(identifier) {
            return systemUsers.find(u => 
                u.username === identifier || 
                u.email === identifier || 
                u.phone === identifier
            );
        }

        function performLogin() {
            const identifier = document.getElementById('loginIdentifier').value.trim();
            const password = document.getElementById('loginPassword').value;
            const rememberMe = document.getElementById('rememberMe').checked;
            const errorDiv = document.getElementById('loginError');
            
            if (!identifier || !password) {
                errorDiv.innerText = "الرجاء إدخال اسم المستخدم/البريد/الهاتف وكلمة المرور";
                errorDiv.style.display = "block";
                return;
            }
            
            const user = findUserByIdentifier(identifier);
            if (!user || user.password !== password) {
                errorDiv.innerText = "بيانات الدخول غير صحيحة";
                errorDiv.style.display = "block";
                return;
            }
            
            if (user.status !== "active") {
                errorDiv.innerText = "هذا الحساب موقوف. يرجى التواصل مع الدعم الفني";
                errorDiv.style.display = "block";
                return;
            }
            
            currentLoggedInUser = user;
            if (rememberMe) {
                localStorage.setItem("alshahd_logged_user", JSON.stringify({ id: user.id, remember: true }));
            } else {
                sessionStorage.setItem("alshahd_logged_user", JSON.stringify({ id: user.id, remember: false }));
            }
            
            document.getElementById('loginOverlay').style.display = 'none';
            document.getElementById('appContainer').style.display = 'block';
            
            window.userData = window.userData || {};
            window.userData.name = user.fullName;
            window.userData.email = user.email;
            window.userData.phone = user.phone;
            window.userData.avatar = user.fullName.charAt(0);
            window.userData.memberId = user.id;
            if (typeof saveUserData === 'function') saveUserData();
            if (typeof applyUserDataToUI === 'function') applyUserDataToUI();
            if (typeof refreshAllPages === 'function') refreshAllPages();
            
            showToast(`مرحباً ${user.fullName}`);
        }

        function toggleRoleFields() {
            const role = document.getElementById('regRole').value;
            document.getElementById('agentFields').style.display = role === 'agent' ? 'block' : 'none';
            document.getElementById('staffFields').style.display = (role === 'shipping_staff' || role === 'support_staff') ? 'block' : 'none';
        }

        function registerNewUser() {
            const fullName = document.getElementById('regFullName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const phone = document.getElementById('regPhone').value.trim();
            const username = document.getElementById('regUsername').value.trim();
            const password = document.getElementById('regPassword').value;
            const confirmPassword = document.getElementById('regConfirmPassword').value;
            const role = document.getElementById('regRole').value;
            const errorDiv = document.getElementById('registerError');
            
            if (!fullName || !email || !phone || !username || !password) {
                errorDiv.innerText = "الرجاء ملء جميع الحقول";
                errorDiv.style.display = "block";
                return;
            }
            
            if (password !== confirmPassword) {
                errorDiv.innerText = "كلمة المرور وتأكيدها غير متطابقتين";
                errorDiv.style.display = "block";
                return;
            }
            
            if (role === 'agent') {
                const idNumber = document.getElementById('regIdNumber').value.trim();
                const commercialReg = document.getElementById('regCommercialReg').value.trim();
                const idImage = document.getElementById('regIdImage').files[0];
                const commercialImage = document.getElementById('regCommercialImage').files[0];
                if (!idNumber || !commercialReg || !idImage || !commercialImage) {

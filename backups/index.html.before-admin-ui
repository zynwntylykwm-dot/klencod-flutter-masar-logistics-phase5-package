            if (event && event.target) event.target.classList.add('active');
            else { const btns = document.querySelectorAll('#myShipmentsPage .filter-btn'); btns.forEach(btn => { const onclickAttr = btn.getAttribute('onclick'); if (onclickAttr && onclickAttr.includes(`'${type}'`)) btn.classList.add('active'); }); }
            document.getElementById('deliveredDateFilter').style.display = 'none';
            displayShipments(type);
        }


            // تعيين الدوال للنطاق العام
            window.portalOpenPurchaseModal = portalOpenPurchaseModal;
            window.portalClosePurchaseModal = function() {
                document.getElementById('portalPurchaseModal').classList.remove('active');
                document.body.style.overflow = '';
            };
            window.portalCalculateInvoice = portalCalculateInvoice;
            window.portalSelectPayment = portalSelectPayment;
            window.portalSubmitPurchase = function(e) {
                e.preventDefault();
                const method = window.portalSelectedPayment;
                if (!method) { alert('❌ يرجى اختيار طريقة الدفع'); return; }
                if (method === 'bank') {
                    const verified = window.portalVerifyBankPayment();
                    if (!verified) return;
                } else if (method === 'crypto') {
                    const verified = window.portalVerifyCryptoPayment();
                    if (!verified) return;
                } else if (method === 'credit') {
                    const verified = window.portalVerifyCreditPayment();
                    if (!verified) return;
                }
            };
            window.portalOpenTracking = portalOpenTracking;
            window.portalSearchTracking = portalSearchTracking;
            window.portalShowFavorites = portalShowFavorites;
            window.updatePortalSearchResults = updatePortalSearchResults;
            window.portalFetchProductData = portalFetchProductData;
            window.portalSearchMerchantById = portalSearchMerchantById;

            // تهيئة البوابة
            container.innerHTML = portalHTML;
            
            // تهيئة الدولة
            portalState.currentTab = 'stores';
            portalState.favorites = [];
            portalState.shipments = [];
            portalState.updateUI();
            
            // تهيئة القائمة المنسدلة
            setupPaymentDropdown();
        }

        // ==================== تهيئة النظام ====================
        loadSystemUsers();
        
        const storedShipments = localStorage.getItem('alshahd_shipments');
        if (storedShipments) { try { shipments = JSON.parse(storedShipments); } catch(e) { console.log('خطأ في تحميل الشحنات، استخدام القائمة الافتراضية'); } }
        
        const storedWarehouses = localStorage.getItem('alshahd_warehouses');
        if (storedWarehouses) { try { warehouses = JSON.parse(storedWarehouses); } catch(e) { console.log('خطأ في تحميل المستودعات، استخدام القائمة الافتراضية'); } }
        
        loadWalletData();
        loadNotifications();
        loadCRMData();
        loadFleetData();
        loadPromoCodes();
        loadFeedbackData();
        loadContractData();
        
        if (typeof window.systemSettings === 'undefined') {
            window.systemSettings = { users: systemUsers.map(u => ({ id: u.id, name: u.fullName, email: u.email, phone: u.phone, role: u.role, status: u.status })), notifications: { shipmentUpdates: true, walletTransactions: true, supportReplies: true, systemAlerts: true } };
        } else {
            window.systemSettings.users = systemUsers.map(u => ({ id: u.id, name: u.fullName, email: u.email, phone: u.phone, role: u.role, status: u.status }));
        }
        
        if (!checkAutoLogin()) {
            document.getElementById('loginOverlay').style.display = 'flex';
            document.getElementById('appContainer').style.display = 'none';
        } else {
            document.getElementById('loginOverlay').style.display = 'none';
            document.getElementById('appContainer').style.display = 'block';
            if (typeof applyUserDataToUI === 'function') applyUserDataToUI();
            if (typeof applyPermissions === 'function') applyPermissions();
        }
        
        setTimeout(() => {
            if (currentLoggedInUser) {
                document.getElementById('welcomeMessage').innerText = `مرحباً بعودتك سيد ${currentLoggedInUser.fullName}`;
                document.getElementById('welcomeModal').classList.add('show');
            }
        }, 500);
        
        setInterval(rotatePromoAd, 5000);
        rotatePromoAd();
        
        console.log('✅ النظام جاهز للعمل مع الوحدات الجديدة والبوابة اللوجستية');
        console.log(`📦 عدد الشحنات: ${shipments.length}`);
        console.log(`🏢 عدد المستودعات: ${warehouses.length}`);
        console.log(`💳 عدد بطاقات المحفظة: ${walletCards.length}`);
        console.log(`👤 عدد العملاء (CRM): ${crmData.length}`);
        console.log(`🚛 عدد المركبات (Fleet): ${fleetData.length}`);
        console.log(`🎫 عدد أكواد الخصم: ${promoCodes.length}`);
        console.log(`💬 عدد الشكاوي: ${feedbackData.length}`);
        console.log(`📄 عدد العقود: ${contractData.length}`);
        console.log('🌐 البوابة اللوجستية العالمية: تم دمجها بنجاح مع 90 موقعاً');
        console.log('🔐 رموز التأكيد: يتم توليدها تلقائياً عند النقر على زر اللصق');
        console.log('🤖 المساعد الذكي: يعمل بنظام الذكاء الاصطناعي المتقدم مع قاعدة معرفة موسعة');

        // ===== [Phase1] جسر الحالة: يسمح لطبقة البيانات (api-client.js) بالقراءة/الكتابة دون تغيير منطق النظام =====
        window.__app = {
            get shipments() { return shipments; },
            set shipments(v) { shipments = v; },
            get warehouses() { return warehouses; },
            get currentUser() { return currentLoggedInUser; },
            set currentUser(u) { currentLoggedInUser = u; },
            saveShipments() { localStorage.setItem('alshahd_shipments', JSON.stringify(shipments)); },
            saveUserData,
            navigateTo, showToast, applyUserDataToUI, applyPermissions, refreshAllPages,
            displayShipments, filterShipments, renderWalletPage, loadStatisticsPage,
            loadReportsPage, loadNotifications, addNotification,
            version: '3.3.0-phase1'
        };

        // ===== [Phase1] فتح الجلسة من الخادم (إن كان متاحًا) بدل الاعتماد على كلمة مرور محلية فقط =====
        if (typeof window.__phase1Boot === 'function') { window.__phase1Boot(); }
    </script>

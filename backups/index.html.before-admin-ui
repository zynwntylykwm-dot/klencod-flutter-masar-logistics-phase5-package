            --field-bg: #f8fafc; --field-border: #e2e8f0;
        }
        body { background: var(--bg-global); display: flex; justify-content: center; min-height: 100vh; padding-bottom: 100px; }
        .app-container { width: 100%; max-width: 480px; background: var(--bg-global); padding: 14px; position: relative; }
        .app-page { display: none; animation: fadeIn 0.3s; }
        #mainPage { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .back-btn-custom { background: #fff; border: none; color: var(--text-dark); font-size: 14px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; margin: 10px 0; padding: 10px 16px; border-radius: 14px; box-shadow: var(--shadow-light); }
        .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px; }
        .service-card { background: var(--card-bg); border-radius: var(--border-radius); aspect-ratio: 1 / 0.9; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; box-shadow: var(--shadow-light); border: 1px solid var(--border-color); cursor: pointer; padding: 6px; text-align: center; transition: all 0.2s; user-select: none; -webkit-user-select: none; -moz-user-select: none; }
        .service-card:active { transform: scale(0.96); }
        .icon-wrapper { font-size: 24px; color: var(--secondary-blue); pointer-events: none; }
        .service-title { font-size: 12px; font-weight: 700; color: var(--text-dark); user-select: none; -webkit-user-select: none; -moz-user-select: none; pointer-events: none; }
        .search-box-wrapper { background: var(--card-bg); border-radius: var(--border-radius); padding: 20px; text-align: center; margin-bottom: 15px; border: 1px solid var(--border-color); }
        .search-box-wrapper h2 { font-size: 16px; margin-bottom: 15px; color: var(--primary-blue); font-weight: 800; }
        .input-container { width: 100%; background: var(--field-bg); border: 1px solid var(--field-border); border-radius: 14px; padding: 12px; display: flex; align-items: center; gap: 10px; }
        .input-container input { width: 100%; border: none; background: none; outline: none; font-size: 14px; font-weight: 700; color: var(--text-dark); }
        .search-trigger-btn { width: 46px; height: 46px; background: linear-gradient(135deg, var(--accent-red), #ff4455); color: white; border: none; border-radius: 50%; font-size: 16px; cursor: pointer; margin-top: 15px; display: inline-flex; align-items: center; justify-content: center; }
        .barcode-btn { background: var(--secondary-blue); margin-right: 10px; }
        .error-message { color: var(--accent-red); background: #fff5f5; border: 1px solid #ffcdcd; padding: 12px; border-radius: 14px; margin-top: 15px; display: none; align-items: center; justify-content: center; gap: 8px; }
        .result-card { background: var(--card-bg); border-radius: var(--border-radius); padding: 16px; display: none; margin-top: 15px; border: 1px solid var(--border-color); }
        .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 15px; }
        .info-item { background: var(--field-bg); padding: 10px 12px; border-radius: 14px; border: 1px solid var(--field-border); position: relative; }
        .info-item.full-width { grid-column: span 2; }
        .info-label { font-size: 10px; color: var(--text-muted); display: block; margin-bottom: 4px; }
        .info-value { font-size: 13px; font-weight: 700; color: var(--text-dark); word-break: break-word; }
        .copy-field-btn { position: absolute; top: 8px; left: 8px; background: none; border: none; color: var(--secondary-blue); cursor: pointer; font-size: 12px; }

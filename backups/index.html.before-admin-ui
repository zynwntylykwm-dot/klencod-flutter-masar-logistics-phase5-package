                    if (!shipment.history) shipment.history = [];
                    shipment.history.push(newPoint);
                    localStorage.setItem('alshahd_shipments', JSON.stringify(shipments));
                    showToast(`✅ تم إضافة نقطة التتبع بنجاح للشحنة ${trackingNumber}`);

            document.getElementById('deliveredDateFilter').style.display = 'flex';
            displayShipments('delivered');
        }

        function filterByDate() {
            const from = document.getElementById('dateFrom').value;
            const to = document.getElementById('dateTo').value;
            let filtered = shipments.filter(s => s.status === 'delivered');
            if (from) filtered = filtered.filter(s => s.deliveryDate && s.deliveryDate >= from);
            if (to) filtered = filtered.filter(s => s.deliveryDate && s.deliveryDate <= to);
            filtered.sort((a, b) => { if (a.deliveryDate > b.deliveryDate) return -1; if (a.deliveryDate < b.deliveryDate) return 1; return 0; });
            let html = `<div class="track-box"><div class="track-number">📊 الشحنات المسلمة: ${filtered.length}</div></div>`;

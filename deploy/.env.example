# ============ إعدادات الخادم الحقيقي ============
DOMAIN=api.example.com
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية-هنا
LOGIN_RATE_LIMIT=40
DEMO_MODE=true
VAPID_SUBJECT=mailto:you@example.com
BACKUP_KEEP_DAYS=14

# ============ إشعارات أندرويد (اختياري) ============
# ملف حساب خدمة Firebase (JSON) — الصق محتواه في سطر واحد أو ضع مسار ملف داخل الحاوية
FCM_SERVICE_ACCOUNT=

# ============ إشعارات آيفون (اختياري) ============
# مفتاح .p8 من Apple Developer + معرّف المفتاح + معرّف الفريق + Bundle ID
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.almasar.logistics

# ============ المساعد الذكي (المرحلة 5) — اختر مزوّدًا واحدًا ============
# ملاحظة: بلا أي مفتاح يعمل المساعد بمحرّك القواعد المُسنَد إلى بيانات المستخدم
# (ويُعلن ذلك بصراحة في الواجهة). أضف مفتاحًا واحدًا فقط لتفعيل نموذج حقيقي.

# 1) OpenAI
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # غيّره لأي خدمة متوافقة (LocalAI / vLLM / LiteLLM)

# 2) OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# 3) Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 4) Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# 5) نموذج محلي عبر Ollama (بلا مفاتيح ولا إنترنت)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

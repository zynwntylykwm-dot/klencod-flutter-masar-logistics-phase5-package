# ============================================================================
#  مثال المتغيّرات — انسخه إلى .env (محليًا) أو الصقه في لوحة Render/Railway
#  ملاحظة: لا تحتاج أي مفتاح للتشغيل الأساسي؛ هذه كلها اختيارية عدا كلمة مرور المدير.
# ============================================================================

# ---------- أساسي ----------
# المنفذ: اتركه فارغًا على Render/Railway (يُضبط تلقائيًا عبر $PORT)
# PORT=8080
HOST=0.0.0.0

# مجلد البيانات — على السحابة اجعله على القرص الدائم
DATA_DIR=/data

# كلمة مرور حساب المدير العام (تُستخدم عند أول تشغيل فقط)
# REQUIRED: غيّرها فورًا بعد أول دخول
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية-هنا

# رابط الخدمة العام (يظهر في /health لتأكيد النشر)
PUBLIC_URL=https://masar-api.onrender.com

# قيود CORS: * تعني السماح لكل الأصول (مناسب لتطبيق الهاتف)
# CORS_ORIGINS=*

# تحديد صراحة هل القرص دائم؟ (true/false) — يُكتشف تلقائيًا على Render/Railway
# STORAGE_PERSISTENT=true

# حد محاولات الدخول لكل دقيقة
LOGIN_RATE_LIMIT=40

# ---------- إشعارات (اختياري) ----------
VAPID_SUBJECT=mailto:you@example.com
FCM_SERVICE_ACCOUNT=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.almasar.logistics

# ---------- شركات الشحن (اختياري) ----------
# 17TRACK_API_KEY=
# DHL_API_KEY=
# UPS_CLIENT_ID=
# FEDEX_API_KEY=

# ---------- المساعد الذكي (اختياري) ----------
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=

# ---------- نسخ احتياطي ----------
# BACKUP_KEEP_DAYS=14
